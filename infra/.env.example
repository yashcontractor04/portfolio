# Copy to infra/.env (which is git-ignored) and fill in. Never commit the real file.
# Supabase -> Connect -> Session pooler. Replace the user with app_worker.<project-ref>
# and the password with the one you set via: alter role app_worker login password '...';
WORKER_DATABASE_URL=postgresql://app_worker.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
WORKER_ID=worker-mac
