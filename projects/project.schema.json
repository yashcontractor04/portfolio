{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yashcontractor04/portfolio/projects/project.schema.json",
  "title": "Project manifest (projects/<slug>/project.yaml)",
  "description": "One manifest per project. The folder name is the slug and the URL. Adding a project = adding a folder with this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "type", "status", "tags", "summary"],
  "properties": {
    "schema": { "const": 1, "description": "Manifest format version." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "type": { "enum": ["static", "in-browser", "runner", "bot-status"] },
    "status": { "enum": ["live", "building", "coming-soon"] },
    "featured": { "type": "boolean", "default": false, "description": "Bigger tile in the bento grid." },
    "order": { "type": "integer", "default": 100, "description": "Lower numbers appear first." },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["python", "bots", "data", "web"] },
      "description": "Drives the dashboard filters (All / Python / Bots / Data / Web)."
    },
    "summary": { "$ref": "#/$defs/localized", "description": "One or two sentences. English first, short German summary." },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "readme": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the Overview tab gets its README. Defaults to README.md at the repo root.",
      "properties": {
        "path": { "type": "string", "default": "README.md" },
        "ref": { "type": "string", "default": "HEAD" }
      }
    },
    "stack": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxItems": 12 },
    "accent": {
      "enum": ["blue", "indigo", "violet", "pink", "orange", "amber", "teal", "cyan"],
      "description": "Accent hue token for the multicolor theme. Green and red are reserved for gains/losses."
    },
    "how_it_works": { "type": "string", "pattern": "^[a-z0-9._-]+\\.mdx?$", "description": "File in this folder with the architecture note." },
    "static": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "pattern": "^[a-z0-9._-]+\\.mdx?$", "description": "Optional write-up file in this folder. Without it the page shows the README only." }
      }
    },
    "in_browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "source"],
      "properties": {
        "entry": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.py$", "description": "Python file to run, relative to source.path." },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "path", "ref"],
          "description": "Code is copied at build time from a pinned commit, never fetched live at runtime.",
          "properties": {
            "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "path": { "type": "string" },
            "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Full commit SHA." }
          }
        },
        "packages": { "type": "array", "items": { "type": "string" }, "maxItems": 10, "description": "Pyodide packages to load." }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "demo"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 900, "default": 120 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
        "key_provider": { "type": "string", "pattern": "^[a-z0-9_]{2,32}$", "description": "External API whose key this runner uses. Omit if none." },
        "disclaimer": { "enum": ["not-financial-advice"] },
        "inputs": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/input" } },
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["params"],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "params": { "type": "object", "description": "Fixed parameters for the guest demo run." }
          }
        }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot_slug"],
      "properties": {
        "bot_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "description": "Row key in the bot_status table." },
        "check_interval_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "in-browser" } } }, "then": { "required": ["in_browser"] } },
    { "if": { "properties": { "type": { "const": "runner" } } }, "then": { "required": ["runner"] } },
    { "if": { "properties": { "type": { "const": "bot-status" } } }, "then": { "required": ["bot"] } }
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 300 },
        "de": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label"],
      "description": "One form field. The web UI builds the form (and its zod validation) from this; the worker validates the same limits again with pydantic.",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "type": { "enum": ["string", "integer", "number", "boolean", "select", "date", "string_list", "number_list"] },
        "label": { "$ref": "#/$defs/localized" },
        "help": { "$ref": "#/$defs/localized" },
        "required": { "type": "boolean", "default": true },
        "default": {},
        "min": { "type": "number", "description": "Minimum value (integer, number, number_list items)." },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "min_date": { "type": "string", "format": "date" },
        "max_date": { "type": "string", "description": "A date or the word 'today'." },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 500, "description": "Maximum characters (string, string_list items)." },
        "pattern": { "type": "string", "description": "Regular expression (string, string_list items)." },
        "min_items": { "type": "integer", "minimum": 0 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 50 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "$ref": "#/$defs/localized" } }
          }
        }
      }
    }
  }
}
