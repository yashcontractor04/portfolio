# Copy to .env.local (web) / .env (worker) and fill in. NEVER commit real values.
# Where each value is allowed to live is noted per line.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # browser + server (public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # browser + server (public; RLS protects the data)
SUPABASE_SECRET_KEY=                 # SERVER ONLY (Vercel). Bypasses RLS.

# --- Web server only --------------------------------------------------------
RESEND_API_KEY=                      # contact form + auth emails
CONTACT_TO_EMAIL=                    # where contact form messages go
IP_HASH_SECRET=                      # 32+ random bytes; HMAC key for rate-limit IP hashing
GITHUB_TOKEN=                        # optional, read-only, raises GitHub API rate limit

# --- Web server + worker ----------------------------------------------------
API_KEY_ENC_KEY_V1=                  # base64 of 32 random bytes: openssl rand -base64 32

# --- Worker only ------------------------------------------------------------
WORKER_DATABASE_URL=                 # session pooler URL, user app_worker.<project-ref>
WORKER_ID=worker-1
MARKET_DATA_API_KEY=                 # the site's own key for market data
